# Copy to .env and adjust: cp .env.example .env
# Never commit the real .env file.

# --- Django ---
# Generate your own key, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
DJANGO_TIME_ZONE=Asia/Almaty

# Console email backend prints order notifications to `docker compose logs web`.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_DEFAULT_FROM_EMAIL=shop@hop-and-barley.local
DJANGO_ORDER_NOTIFICATION_EMAIL=admin@hop-and-barley.local

# --- PostgreSQL ---
POSTGRES_DB=shop
POSTGRES_USER=shop
POSTGRES_PASSWORD=change-me
# Used when running manage.py/pytest on the host; Compose overrides it with "db".
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- JWT ---
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# --- Demo data ---
# 1 = fill the catalog and create demo accounts on container start (idempotent).
SEED_DEMO_DATA=1
